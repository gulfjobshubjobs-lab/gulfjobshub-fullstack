# Set these before the first start to create the first administrator account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Production must use HTTPS so the session cookie is Secure.
NODE_ENV=production
PORT=3000
# Mount persistent storage here in production.
DATA_DIR=/var/lib/gulfjobshub

# Require ClamAV scanning before accepting any CV upload (recommended in production).
REQUIRE_MALWARE_SCAN=true
# Optional absolute path if clamscan is not on PATH.
# CLAMSCAN_PATH=/usr/bin/clamscan
